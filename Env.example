# Nusxa oling: cp .env.example .env — va haqiqiy qiymatlarni kiriting

# ── baza ──
DATABASE_URL=postgresql+asyncpg://premolux:parol@localhost:5432/premolux

# ── Telegram ──
# my.telegram.org dan olinadi
TG_API_ID=0
TG_API_HASH=

# @BotFather dan olingan boshqaruv boti tokeni (WebApp shu botga bog'lanadi)
BOT_TOKEN=

# majburiy obuna kanali
REQUIRED_CHANNEL=@PremoLux

# ── xavfsizlik ──
JWT_SECRET=uzun-tasodifiy-satr-shu-yerga
PREMOLUX_ENC_KEY=

# ── ish jarayoni ──
MAX_PARALLEL_LANES=12
OTP_WAIT_TIMEOUT_SEC=90
LOGIN_CODE_TIMEOUT_SEC=60

SESSIONS_DIR=./sessions
